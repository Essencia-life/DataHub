DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
API_SHARED_SECRET=change-me
NODE_ENV=development

# --- Grafana Cloud (optional) -------------------------------------------------
# Leave these empty to keep writing everything to Neon only (previous behaviour).
# Push URL from the "InfluxDB" card in the Grafana Cloud portal (ends with /api/v1/push/influx/write)
GRAFANA_INFLUX_URL=
# Metrics instance ID (Basic auth username)
GRAFANA_USER=
# Cloud access policy token (metrics:write)
GRAFANA_WRITE_TOKEN=
# Sources that are streamed to Grafana (comma separated). Everything else, e.g. "manual", goes straight to Neon.
GRAFANA_SOURCES=lora-tank,studer-xcom,generic
# While migrating, stream sources are still written to Neon as well.
# Set to "false" once the daily export from Grafana to Neon is running.
NEON_STREAM_WRITES=true

# --- Daily export Grafana -> Neon (api/export, Vercel Cron) --------------------
# Query endpoint from the "Prometheus" card (Details), e.g. https://prometheus-prod-xx.grafana.net/api/prom
GRAFANA_QUERY_URL=
# Cloud access policy token (metrics:read). GRAFANA_USER is shared with the push settings above.
GRAFANA_READ_TOKEN=
# Vercel sends this as "Authorization: Bearer <CRON_SECRET>" to the cron endpoint. Use a long random string.
CRON_SECRET=
# Optional: how far back each run looks (hours, default 30, max 336) ...
EXPORT_LOOKBACK_HOURS=30
# ... and which sources are exported as averages (source=seconds, comma separated), others raw.
EXPORT_BUCKETS=studer-xcom=300
